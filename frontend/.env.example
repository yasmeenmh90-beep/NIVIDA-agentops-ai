# Backend URL and one of the backend's API_KEYS. Both can also be changed in the app under Settings.
VITE_API_URL=http://localhost:8000
VITE_AGENTOPS_KEY=

# Optional public origin, with no trailing slash. When set, the production build
# adds canonical URLs, an absolute social image URL, and sitemap.xml.
# VITE_SITE_URL=https://example.com

# Optional. Leave empty to send no analytics. If set, the dashboard asks before
# sending a page name. Incident contents are never included.
# VITE_ANALYTICS_ENDPOINT=

