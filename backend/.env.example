# --- NVIDIA Nemotron on Nebius Token Factory (required) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm IDs with: python scripts/check_nebius.py
MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
MODEL_TRIAGE=nvidia/nemotron-3-nano-omni

# --- Tavily web search (optional, used by the Investigator) ---
TAVILY_API_KEY=

# --- GitHub PRs (needed for Approve). Fine-grained token scoped to ONE repo:
#     Contents: read/write, Pull requests: read/write
GITHUB_TOKEN=
GITHUB_REPO=your-user/agentops-ai
GITHUB_BASE_BRANCH=main
# Path of the target app inside that GitHub repo ("" if the target repo IS the GitHub repo)
GITHUB_PATH_PREFIX=demo-app

# --- Target repo and sandbox ---
# TARGET_REPO_PATH defaults to ../demo-app
SANDBOX_MODE=auto            # auto | docker | subprocess
MAX_FIX_ATTEMPTS=3
MAX_PATCH_LINES=40
MAX_TOKENS_PER_INCIDENT=400000

# --- App ---
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: SQLite file)
CORS_ORIGINS=http://localhost:5173
EMBED_DEMO_APP=true
# DEMO_APP_URL=http://localhost:8001   # use a separately running demo app instead of the embedded one
