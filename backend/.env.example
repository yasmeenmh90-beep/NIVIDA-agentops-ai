# ---- Required ----
# NVIDIA Nemotron on Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the IDs your key can use with: python scripts/check_nebius.py
MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
MODEL_TRIAGE=nvidia/nemotron-3-nano-omni

# API keys clients must send (X-API-Key or Authorization: Bearer). Comma-separated.
# Empty = auth disabled; never expose the server like that.
API_KEYS=

# ---- GitHub ----
# Token used to clone private repos and open PRs. Fine-grained, limited to the repos you register:
#   Contents: read/write, Pull requests: read/write
# Projects can point at a different env var via github_token_env.
GITHUB_TOKEN=

# ---- Optional ----
TAVILY_API_KEY=
WORKSPACE_DIR=./workspace
SANDBOX_MODE=auto            # auto | docker | subprocess (project setting overrides)
MAX_FIX_ATTEMPTS=3
MAX_PATCH_LINES=40
MAX_TOKENS_PER_INCIDENT=400000
AUTO_INVESTIGATE=true
WORKER_THREADS=2
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: SQLite file in backend/)
CORS_ORIGINS=http://localhost:5173
# ALLOW_LOCAL_REPOS=false     # true lets repo_url be a local path / file:// URL (self-hosted mirrors)
