# ---- Required ----
# NVIDIA Nemotron on Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the IDs your key can use with: python scripts/check_nebius.py
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# API keys clients must send (X-API-Key or Authorization: Bearer). Comma-separated.
# Empty = auth disabled; never expose the server like that.
API_KEYS=

# ---- Accounts (dashboard sign-up / sign-in) ----
# The first account created becomes admin. Later accounts get DEFAULT_ROLE.
# Roles: viewer = read-only, member = approve/reject/revise/cancel/run + repositories, admin = member + manage users.
FRONTEND_URL=http://localhost:5173
SIGNUP_MODE=open              # open | closed (closed: only the first account can sign up)
DEFAULT_ROLE=viewer           # viewer | member
SESSION_DAYS=14
# "Sign in with GitHub": create an OAuth App at https://github.com/settings/developers
#   Homepage URL: your dashboard URL   Callback URL: <backend URL>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- GitHub ----
# Token used to clone private repos and open PRs. Fine-grained, limited to the repos you register:
#   Contents: read/write, Pull requests: read/write
# Projects can point at a different env var via github_token_env.
GITHUB_TOKEN=

# ---- Optional ----
TAVILY_API_KEY=
# WORKSPACE_DIR=/absolute/path/to/workspace   (default: backend/workspace)
SANDBOX_MODE=auto            # auto | docker | subprocess (project setting overrides)
MAX_FIX_ATTEMPTS=3
MAX_PATCH_LINES=40
MAX_TOKENS_PER_INCIDENT=400000
AUTO_INVESTIGATE=true
WORKER_THREADS=2
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: SQLite file in backend/)
CORS_ORIGINS=http://localhost:5173
# ALLOW_LOCAL_REPOS=false     # true lets repo_url be a local path / file:// URL (self-hosted mirrors)

# ---- Fix policy ----
REQUIRE_REGRESSION_TEST=true  # a fix only counts if it adds a test that fails before and passes after
MAX_TEST_LINES=120
MAX_REVISIONS=3               # reviewer-requested PR revisions per incident

# ---- GitHub webhook (PR merged/closed, review feedback -> revision) ----
# In the repo: Settings -> Webhooks -> Add webhook
#   Payload URL: https://<your-agentops-host>/webhooks/github   Content type: application/json
#   Secret: same value as below. Events: Pull requests, Pull request reviews, Issue comments
GITHUB_WEBHOOK_SECRET=
REVISION_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# ---- Sentry (optional) ----
# Internal integration webhook URL: https://<your-agentops-host>/webhooks/sentry/<project-name>
SENTRY_CLIENT_SECRET=

# ---- Notifications (all optional) ----
PUBLIC_BASE_URL=              # e.g. https://agentops.example.com (used for links)
SLACK_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=medium
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=


